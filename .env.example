# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# O .env está no .gitignore e NUNCA deve ser compartilhado ou colado em chats.

# Chave da Binance: crie com APENAS "Enable Reading" marcada.
# Sem trading, sem saque, sem transferências. Se tiver qualquer outra permissão,
# o agente detecta e se recusa a rodar. Recomendado: restringir ao seu IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=
